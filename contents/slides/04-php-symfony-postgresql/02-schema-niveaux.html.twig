<section>
    <h2>Chiffrer, oui, mais où ?</h2>

    <svg class="schema" viewBox="0 0 960 250" role="img" aria-label="Une requête SQL part de l'application et arrive au serveur PostgreSQL">
        <defs>
            <marker id="arrow-niveaux" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
                <path class="schema-arrow-head" d="M0,0 L6,3 L0,6 Z"/>
            </marker>
        </defs>

        {# Application #}
        <rect class="schema-container" x="40" y="20" width="240" height="210" rx="8"/>
        <text class="schema-title" x="160" y="50">Application</text>

        <rect class="schema-block" x="70" y="75" width="180" height="60" rx="4"/>
        <text class="schema-block-text" x="160" y="111">Symfony + Doctrine</text>

        <g class="fragment" data-fragment-index="7">
            <rect class="schema-band secured" x="70" y="180" width="180" height="32" rx="4"/>
            <text class="schema-band-text" x="160" y="201">Chiffrement</text>
        </g>

        {# Réseau : la requête SQL #}
        <g class="fragment" data-fragment-index="4">
            <rect class="schema-tls" x="290" y="122" width="380" height="36" rx="18"/>
            <text class="schema-tls-text" x="480" y="182">TLS</text>
        </g>

        <line class="schema-arrow" x1="290" y1="140" x2="668" y2="140" marker-end="url(#arrow-niveaux)"/>

        <text class="schema-code" x="480" y="82">INSERT INTO "user" (email)</text>
        <text class="schema-code fragment fade-out" data-fragment-index="7" x="480" y="106">VALUES (<tspan class="schema-clear">'jane@example.com'</tspan>)</text>
        <text class="schema-code fragment" data-fragment-index="7" x="480" y="106">VALUES (<tspan class="schema-cipher">'AQf3…9Qk='</tspan>)</text>

        {# Serveur PostgreSQL #}
        <rect class="schema-container" x="680" y="20" width="260" height="210" rx="8"/>
        <text class="schema-title" x="810" y="50">Serveur PostgreSQL</text>

        <rect class="schema-block" x="700" y="62" width="220" height="70" rx="4"/>
        <text class="schema-block-text" x="810" y="88">SGBD</text>
        <text class="schema-code schema-clear fragment fade-out" data-fragment-index="7" x="810" y="118">jane@example.com</text>
        <text class="schema-code schema-cipher fragment" data-fragment-index="7" x="810" y="118">AQf3…9Qk=</text>

        <line class="schema-link" x1="810" y1="132" x2="810" y2="150"/>

        <rect class="schema-storage" x="760" y="150" width="100" height="35" rx="4"/>
        <text class="schema-storage-text" x="810" y="173">Disque</text>

        <g class="fragment" data-fragment-index="1">
            <rect class="schema-band secured" x="760" y="192" width="100" height="26" rx="4"/>
            <text class="schema-band-text" x="810" y="210">Chiffré</text>
        </g>
    </svg>

    <div class="layer-grid">
        <div class="layer-col fragment" data-fragment-index="7">
            <h3>Côté application</h3>
            <p class="layer-yes fragment" data-fragment-index="8">Le SGBD ne voit que du chiffré.</p>
            <p class="layer-no fragment" data-fragment-index="9">Application compromise : la clé est en mémoire.</p>
        </div>

        <div class="layer-col fragment" data-fragment-index="4">
            <h3>En transit</h3>
            <p class="layer-yes fragment" data-fragment-index="5">L'écoute du réseau.</p>
            <p class="layer-no fragment" data-fragment-index="6">À l'arrivée, la donnée est en clair dans le SGBD.</p>
        </div>

        <div class="layer-col fragment" data-fragment-index="1">
            <h3>Au repos</h3>
            <p class="layer-yes fragment" data-fragment-index="2">Le disque volé, le serveur mis au rebut.</p>
            <p class="layer-no fragment" data-fragment-index="3">Le SGBD déchiffre pour tout accès SQL : DBA, injection, dump.</p>
        </div>
    </div>
</section>
