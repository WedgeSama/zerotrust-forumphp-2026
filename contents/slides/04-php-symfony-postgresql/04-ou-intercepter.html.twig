<section>
    <h2>Où intercepter la donnée ?</h2>

    <svg class="schema" viewBox="0 0 960 250" role="img" aria-label="Une application Symfony passe par Doctrine pour parler au serveur PostgreSQL">
        <defs>
            <marker id="arrow-archi" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
                <path class="schema-arrow-head" d="M0,0 L6,3 L0,6 Z"/>
            </marker>
        </defs>

        {# Application PHP #}
        <rect class="schema-container" x="40" y="20" width="460" height="210" rx="8"/>
        <text class="schema-title" x="270" y="50">Application PHP</text>

        <rect class="schema-block" x="70" y="75" width="160" height="60" rx="4"/>
        <text class="schema-block-text" x="150" y="111">Symfony</text>

        <line class="schema-arrow" x1="230" y1="105" x2="298" y2="105" marker-end="url(#arrow-archi)"/>

        <rect class="schema-block" x="310" y="75" width="160" height="60" rx="4"/>
        <text class="schema-block-text" x="390" y="111">Doctrine</text>

        <g class="fragment" data-fragment-index="2">
            <rect class="schema-block focus" x="310" y="75" width="160" height="60" rx="4"/>
            <text class="schema-block-text focus" x="390" y="111">Doctrine</text>
            <text class="schema-note" x="390" y="170">Un seul point à intercepter</text>
        </g>

        {# Vers le serveur #}
        <g>
            <line class="schema-arrow" x1="470" y1="105" x2="668" y2="105" marker-end="url(#arrow-archi)"/>
            <text class="schema-arrow-label" x="585" y="95">SQL</text>

            <rect class="schema-container" x="680" y="20" width="260" height="210" rx="8"/>
            <text class="schema-title" x="810" y="50">Serveur PostgreSQL</text>

            <rect class="schema-block" x="700" y="62" width="220" height="70" rx="4"/>
            <text class="schema-block-text" x="810" y="103">SGBD</text>

            <line class="schema-link" x1="810" y1="132" x2="810" y2="150"/>

            <rect class="schema-storage" x="760" y="150" width="100" height="35" rx="4"/>
            <text class="schema-storage-text" x="810" y="173">Disque</text>
        </g>
    </svg>

    <p class="fragment">
        Un <span class="accent-trust">Type Custom</span> Doctrine par champ
    </p>

    <p class="fragment">
        Chiffrement et clés à gérer
    </p>
</section>
